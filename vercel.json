{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/ryan-assistant",
      "destination": "/api/admin/ryan-assistant?route=ryan-assistant"
    },
    {
      "source": "/renew/:token",
      "destination": "/api/meta/webhook?renew=1&token=:token"
    }
  ],
  "crons": [
    {
      "path": "/api/automation-run",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/subscription-whatsapp-notifications",
      "schedule": "15 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
