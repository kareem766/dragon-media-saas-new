{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/ryan-assistant", "destination": "/api/admin/ryan-assistant?route=ryan-assistant" },
    { "source": "/renew/:token", "destination": "/api/meta/webhook?renew=1&token=:token" }
  ],
  "crons": [
    {
      "path": "/api/automation-run",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/subscription-whatsapp-notifications",
      "schedule": "15 0 * * *"
    }
  ]
}
