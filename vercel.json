{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ryan-assistant",
      "destination": "/api/admin/ryan-assistant?route=ryan-assistant"
    },
    {
      "source": "/api/subscription-whatsapp-notifications",
      "destination": "/api/automation-run?job=subscription"
    },
    {
      "source": "/renew/:token",
      "destination": "/api/meta/webhook?renew=1&token=:token"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/automation-run",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/subscription-whatsapp-notifications",
      "schedule": "15 0 * * *"
    }
  ]
}